{
  "compilerOptions": {
    // --- Output & Compilation ---
    // Target modern JavaScript that all current browsers support
    "target": "ES2017",
    // DOM types for browser APIs, esnext for modern JS features
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    // Allow importing .js files alongside .ts (useful for some packages)
    "allowJs": true,
    // Skip type-checking of node_modules — dramatically speeds up builds
    "skipLibCheck": true,
    // --- Strictness ---
    // Enable ALL strict checks: strictNullChecks, noImplicitAny, etc.
    // This is what "real TypeScript" looks like — catches bugs before runtime
    "strict": true,
    // --- Module System ---
    // Don't emit compiled files — Next.js handles compilation internally
    "noEmit": true,
    // Allows: import React from 'react' (default import from CommonJS modules)
    "esModuleInterop": true,
    // Use ESModules syntax in source files
    "module": "esnext",
    // "bundler" is the correct resolution strategy for Webpack/Turbopack (Next.js)
    "moduleResolution": "bundler",
    // Allow importing JSON files as modules
    "resolveJsonModule": true,
    // Each file is treated as a separate module — required for React JSX transform
    "isolatedModules": true,
    // Preserve JSX for Next.js to transform (don't compile JSX to React.createElement here)
    "jsx": "react-jsx",
    // --- Performance ---
    // Cache compilation results between runs for faster rebuilds
    "incremental": true,
    // --- Next.js Plugin ---
    // Enables the Next.js TypeScript plugin for better IDE support and type checking
    "plugins": [
      {
        "name": "next"
      }
    ],
    // --- Path Aliases ---
    // @/* maps to src/* — enables clean imports like: import { Button } from '@/components/Button'
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  // Which files TypeScript should check
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // Always exclude node_modules from type checking
  "exclude": [
    "node_modules"
  ]
}
