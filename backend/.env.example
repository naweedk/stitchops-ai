# Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# Server Port
PORT=4000

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stitchops_db?schema=public

# Google Gemini API Key (Backend-only; never exposed to browser)
GEMINI_API_KEY=
