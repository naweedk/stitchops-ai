# Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# Server Port
PORT=4000

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String
# Matches the local Docker Compose configuration (docker-compose.yml on port 5433)
DATABASE_URL=postgresql://stitchops:stitchops_secret@localhost:5433/stitchops_db?schema=public

# Google Gemini API Key (Backend-only; never exposed to browser)
GEMINI_API_KEY=
